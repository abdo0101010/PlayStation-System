@{
    ViewData["Title"] = "بدء / فتح وردية جديدة";
    Layout = "_Layout";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-dark text-white p-3 text-center">
                    <i class="fa-solid fa-cash-register fa-2x text-warning mb-2"></i>
                    <h5 class="fw-bold mb-0">بدء وردية جديدة</h5>
                    <small class="text-white-50">
                        الكاشير: @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "الموظف الحالي")
                    </small>
                </div>

                <div class="card-body p-4">
                    <form asp-action="OpenShift" method="post">
                        @Html.AntiForgeryToken()

                        <!-- إدخال رصيد البداية -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">عهدة البداية / الفكة بالدرج <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-warning">
                                    <i class="fa-solid fa-coins"></i>
                                </span>
                                <input type="number"
                                       name="startingCash"
                                       id="startingCash"
                                       class="form-control text-center fw-bold fs-4"
                                       placeholder="0.00"
                                       step="0.5"
                                       min="0"
                                       value="0"
                                       required
                                       autofocus />
                                <span class="input-group-text bg-light fw-bold">ج.م</span>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                أدخل مبلغ الفكة المسلم لك في الدرج لبدء حسابات الوردية بدقة.
                            </small>
                        </div>

                        <!-- الأزرار -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-play me-1"></i> تأكيد وبدء الوردية
                            </button>
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                                إلغاء
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
@using PlaystationSystem.ViewModel
@model IEnumerable<PricingDeviceViewMOdel>

@{
    ViewData["Title"] = "تعرفة وتسهير الأجهزة";
}

<div class="container-fluid py-3" dir="rtl">

    <!-- Header Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-tags text-warning me-2"></i>جدول الأجهزة والأسعار
            </h2>
            <p class="text-muted small mb-0">عرض مجمع وسريع لأسعار ساعات الأجهزة (Single & Multi) وتحديث التعرفة</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm me-1">
                <i class="fa-solid fa-plus me-1"></i> إضافة جهاز جديد
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fa-solid fa-arrow-right me-1"></i> العودة للأجهزة
            </a>
        </div>
    </div>

    <!-- Pricing Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">متوسط سعر الساعة (Single)</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.AverageSinglePrice.ToString("N2") ج.م</h3>
                    </div>
                    <i class="fa-solid fa-user fa-2x text-white-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-info text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">متوسط سعر الساعة (Multi)</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.AverageMultiPrice.ToString("N2") ج.م</h3>
                    </div>
                    <i class="fa-solid fa-user-group fa-2x text-white-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-dark text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">عدد الأجهزة المسجلة</h6>
                        <h3 class="fw-bold mb-0">@Model.Count() جهاز</h3>
                    </div>
                    <i class="fa-solid fa-tv fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Pricing Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
            <h5 class="fw-bold mb-0 text-secondary">
                <i class="fa-solid fa-file-invoice-dollar me-2 text-warning"></i>قائمة الأسعار والتعرفة
            </h5>
            <span class="badge bg-light text-dark border">PlayStation System</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th># ID</th>
                            <th>اسم الجهاز / الشاشة</th>
                            <th>النوع</th>
                            <th>سعر الساعة (Single)</th>
                            <th>سعر الساعة (Multi)</th>
                            <th>الحالة الحالية</th>
                            <th>تعديل الأسعار</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-muted py-4">لا توجد أجهزة مسجلة لعرض أسعارها</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var device in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@device.DeviceId</td>
                                    <td class="fw-bold text-dark">
                                        <i class="fa-solid fa-tv me-1 text-secondary"></i> @device.DeviceName
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-normal">@device.Type</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-primary fs-6">@device.HourPriceSingle.ToString("N2") ج.م</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success fs-6">@device.HourPriceMulti.ToString("N2") ج.م</span>
                                    </td>
                                    <td>
                                        @if (device.IsOccupied)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-1 rounded-pill">
                                                مشغول
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">
                                                متاح
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@device.DeviceId" class="btn btn-sm btn-outline-warning rounded-pill px-3" title="تعديل الأسعار">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> تعديل السعر
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
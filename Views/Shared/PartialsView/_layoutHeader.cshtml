<header dir="rtl">
    <nav class="navbar navbar-dark bg-dark bg-opacity-95 shadow-sm px-4 py-2 sticky-top border-bottom border-secondary border-opacity-25">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- عنوان الصفحة أو مسار سريع -->
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h6 class="mb-0 text-white-50 fw-normal">لوحة التشغيل اليومية</h6>
            </div>

            <!-- الإجراءات السريعة وحالة الوردية -->
            <div class="d-flex align-items-center gap-3">

                <!-- زر تسجيل مصروف سريع -->
                <a asp-controller="Shift" asp-action="AddExpense" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                    <i class="fa-solid fa-minus-circle me-1"></i> تسجيل مصروف
                </a>

                <!-- بطاقة حالة الوردية -->
                <div class="bg-dark border border-success border-opacity-50 rounded-pill px-3 py-1 d-flex align-items-center gap-2 shadow-sm text-nowrap">
                    <span class="spinner-grow spinner-grow-sm text-success" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                    <span class="text-white-50 small">الوردية:</span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-0.5 fw-semibold small">
                        نشطة
                    </span>
                </div>

                <!-- قائمة المستخدم والتقفيل -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- يظهر فقط للمستخدم المسجل دخوله -->
                    <a asp-controller="Shift" asp-action="AddExpense" class="btn btn-outline-danger btn-sm rounded-pill">
                        <i class="fa-solid fa-minus-circle me-1"></i> تسجيل مصروف
                    </a>

                    <div class="dropdown d-inline-block ms-2">
                        <button class="btn btn-warning rounded-pill dropdown-toggle fw-bold text-dark px-3" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-user-circle me-1"></i> @(User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "حسابي")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 text-end" aria-labelledby="userMenu">
                            <li>
                                <a class="dropdown-item text-warning fw-bold" asp-controller="Shift" asp-action="CloseShift">
                                    <i class="fa-solid fa-lock text-warning me-2"></i> إنهاء الوردية (تقفيل)
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger fw-bold">
                                        <i class="fa-solid fa-arrow-right-from-bracket text-danger me-2"></i> تسجيل الخروج
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <!-- يظهر فقط للزائر غير المسجل -->
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> تسجيل الدخول
                    </a>
                }

        </div>
    </nav>
</header>
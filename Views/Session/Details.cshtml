@model PlaystationSystem.ViewModel.SessionDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الجلسة";
    Layout = "_Layout";

    var duration = (Model.Session.EndTime ?? DateTime.Now) - Model.Session.StartTime;
    if (duration.TotalSeconds < 0) duration = TimeSpan.Zero;
    var hours = (int)duration.TotalHours;
    var minutes = duration.Minutes;
}

<div class="container py-4" dir="rtl">

    <!-- Top Bar / Back Button -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-file-invoice text-primary me-2"></i>تفاصيل الجلسة
            </h3>
            <p class="text-muted small mb-0">كشف حساب الجلسة والطلبات المستهلكة</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ActiveSessions" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-right me-1"></i> العودة للجلسات النشطة
            </a>

            <!-- زر حذف الجلسة للآدمن فقط -->
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <form asp-controller="Session" asp-action="Delete" asp-route-sessionId="@Model.Session.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الجلسة؟ سيتم استرجاع طلبات البوفيه للمخزن وإتاحة الجهاز.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3 shadow-sm">
                        <i class="fa-solid fa-trash me-1"></i> حذف الجلسة
                    </button>
                </form>
            }

            <button type="button" class="btn btn-dark rounded-pill px-4 shadow-sm" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> طباعة الفاتورة
            </button>
        </div>
    </div>

    <div class="row g-4">

        <!-- معلومات الجلسة الأساسية -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-dark text-white py-3 px-4 rounded-top-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-tv me-2 text-warning"></i>@Model.DeviceName
                    </h5>
                    @if (Model.Session.IsOpen)
                    {
                        <span class="badge bg-success rounded-pill px-3 py-1">جلسة جارية</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill px-3 py-1">مغلقة</span>
                    }
                </div>

                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-user me-2"></i>العميل:</span>
                            <span class="fw-bold text-dark">@Model.CustomerName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-sliders me-2"></i>نظام اللعب:</span>
                            <span class="badge @(Model.Session.Mode == "Multi" ? "bg-warning text-dark" : "bg-info") rounded-pill px-3 py-1">
                                @(Model.Session.Mode == "Multi" ? "زوجي (Multi)" : "فردي (Single)")
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-clock me-2"></i>وقت البدء:</span>
                            <span class="fw-bold">@Model.Session.StartTime.ToString("hh:mm tt - yyyy/MM/dd")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-flag-checkered me-2"></i>وقت الانتهاء:</span>
                            <span class="fw-bold">
                                @(Model.Session.EndTime.HasValue? Model.Session.EndTime.Value.ToString("hh:mm tt - yyyy/MM/dd") : "مستمرة الآن")
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-hourglass-half me-2"></i>المدة المستغرقة:</span>
                            <span class="fw-bold text-primary">@hours ساعة و @minutes دقيقة</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="fa-solid fa-money-check me-2"></i>حالة الدفع:</span>
                            @if (Model.Session.IsPaid)
                            {
                                <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1">تم التحصيل</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-1">غير مدفوعة</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- تفاصيل الحساب والطلبات -->
        <div class="col-lg-7">

            <!-- جدول طلبات البوفيه -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-light py-3 px-4 rounded-top-4 border-0">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-mug-hot text-danger me-2"></i>طلبات ومسليات البوفيه
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-center">
                            <thead class="table-light">
                                <tr>
                                    <th class="py-3">الصنف</th>
                                    <th class="py-3">الكمية</th>
                                    <th class="py-3">سعر الوحدة</th>
                                    <th class="py-3">الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Session.Orders != null && Model.Session.Orders.Any())
                                {
                                    foreach (var order in Model.Session.Orders)
                                    {
                                        <tr>
                                            <td class="fw-bold">@order.Product?.Name</td>
                                            <td><span class="badge bg-secondary rounded-pill px-2">@order.Quantity</span></td>
                                            <td>@order.UnitPrice.ToString("N2") ج.م</td>
                                            <td class="fw-bold text-success">@((order.UnitPrice * order.Quantity).ToString("N2")) ج.م</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="py-4 text-muted">لم يتم طلب أي منتجات في هذه الجلسة</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- كارت ملخص الفاتورة النهائي -->
            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2">
                        <i class="fa-solid fa-calculator text-warning me-2"></i>ملخص الحساب
                    </h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">تكلفة الوقت:</span>
                        <span class="fw-semibold">@Model.Session.DeviceCost.ToString("N2") ج.م</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-white-50">إجمالي البوفيه والمسليات:</span>
                        <span class="fw-semibold">@Model.Session.ProductsCost.ToString("N2") ج.م</span>
                    </div>

                    @if (Model.Session.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-warning">
                            <span>الخصم المطبق:</span>
                            <span class="fw-semibold">-@Model.Session.DiscountAmount.ToString("N2") ج.م</span>
                        </div>
                    }

                    <hr class="border-secondary my-3" />

                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold text-warning mb-0">المبلغ الإجمالي:</h4>
                        <h3 class="fw-bold text-success mb-0" dir="ltr">@Model.Session.TotalAmount.ToString("N2") ج.م</h3>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
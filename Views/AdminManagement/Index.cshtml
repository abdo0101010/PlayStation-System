@model IEnumerable<PlaystationSystem.Models.ApplicationUser>

@{
    ViewData["Title"] = "إدارة الاشتراكات والمشتركين";
    Layout = "_Layout";
}

<div class="container py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold"><i class="fa-solid fa-users-gear text-primary me-2"></i>إدارة اشتراكات مدراء الفروع</h3>
            <p class="text-muted mb-0">متابعة الفترات التجريبية، تجديد الباقات، وتعطيل المتأخرين عن السداد.</p>
        </div>
        <a asp-controller="Account" asp-action="CreateAdmin" class="btn btn-primary rounded-pill px-4 fw-bold">
            <i class="fa-solid fa-user-plus me-1"></i> إضافة عميل/أدمن جديد
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="table-dark">
                    <tr>
                        <th>الاسم / المستخدم</th>
                        <th>الهاتف</th>
                        <th>نوع الباقة</th>
                        <th>تاريخ الانتهاء</th>
                        <th>حالة الحساب</th>
                        <th>التحكم والإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var admin in Model)
                    {
                        var isExpired = admin.SubscriptionEndDate.HasValue && admin.SubscriptionEndDate.Value < DateTime.UtcNow;
                        <tr>
                            <td class="text-start ps-3">
                                <span class="fw-bold d-block">@admin.FullName</span>
                                <small class="text-muted">@@@admin.UserName</small>
                            </td>
                            <td>@(admin.PhoneNumber ?? "غير مسجل")</td>
                            <td>
                                @if (admin.SubscriptionType == PlaystationSystem.Enums.SubscriptionType.Lifetime)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fa-solid fa-crown me-1"></i> مدى الحياة</span>
                                }
                                else if (admin.SubscriptionType == PlaystationSystem.Enums.SubscriptionType.Yearly)
                                {
                                    <span class="badge bg-info px-3 py-2 rounded-pill">سنوي</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">شهري</span>
                                }
                            </td>
                            <td>
                                @if (admin.SubscriptionEndDate.HasValue)
                                {
                                    <span class="@(isExpired ? "text-danger fw-bold" : "text-dark")">
                                        @admin.SubscriptionEndDate.Value.ToString("yyyy-MM-dd")
                                    </span>
                                    if (isExpired)
                                    {
                                        <small class="badge bg-danger ms-1">منتهي</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-success fw-bold">مفتوح (دائم)</span>
                                }
                            </td>
                            <td>
                                @if (admin.IsActive && !isExpired)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-1">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-1">معطل / موقف</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- زر التفعيل / الإيقاف -->
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@admin.Id" />
                                        <button type="submit" class="btn btn-sm @(admin.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill px-3">
                                            <i class="fa-solid @(admin.IsActive ? "fa-ban" : "fa-check") me-1"></i>
                                            @(admin.IsActive ? "تعطيل الحساب" : "تفعيل الحساب")
                                        </button>
                                    </form>

                                    <!-- زر التجديد السريع عبر Modal أو فورم -->
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#renewModal-@admin.Id">
                                        <i class="fa-solid fa-arrows-rotate me-1"></i> تجديد الباقة
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <!-- نافذة تجديد الاشتراك Modal -->
                        <div class="modal fade" id="renewModal-@admin.Id" tabindex="-1" aria-hidden="true" dir="rtl">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title fw-bold">تجديد باقة العميل: @admin.FullName</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-action="RenewSubscription" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@admin.Id" />
                                        <div class="modal-body">
                                            <div class="mb-3 text-start">
                                                <label class="form-label fw-bold">نوع الاشتراك الجديد:</label>
                                                <select name="type" class="form-select">
                                                    <option value="1">اشتراك شهري (Monthly)</option>
                                                    <option value="2">اشتراك سنوي (Yearly)</option>
                                                    <option value="3">مدى الحياة (Lifetime)</option>
                                                </select>
                                            </div>
                                            <div class="mb-3 text-start">
                                                <label class="form-label fw-bold">عدد الشهور (في حالة الشهري):</label>
                                                <input type="number" name="durationInMonths" class="form-control" value="1" min="1" max="12" />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0">
                                            <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">إلغاء</button>
                                            <button type="submit" class="btn btn-success rounded-pill px-4">تأكيد التجديد</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
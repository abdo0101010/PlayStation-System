@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "إدارة الصلاحيات (Roles)";
}

<div class="container py-4" dir="rtl">

    <!-- رسائل التنبيه -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- شريط العنوان والأزرار -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-shield-halved text-primary me-2"></i>إدارة الصلاحيات والأدوار
            </h3>
            <p class="text-muted small mb-0">عرض وإدارة جميع الأدوار المعتمدة في النظام</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateRole" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                <i class="fa-solid fa-plus me-1"></i> إضافة رول جديدة
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fa-solid fa-arrow-right me-1"></i> العودة للرئيسية
            </a>
        </div>
    </div>

    <!-- جدول عرض الرولز -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-list-check text-secondary me-2"></i>قائمة الأدوار المتاحة
            </h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                العدد: @Model.Count()
            </span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-user-shield fa-3x text-muted mb-3"></i>
                    <h5 class="text-secondary">لا توجد صلاحيات مسجلة حتى الآن</h5>
                    <a asp-action="CreateRole" class="btn btn-primary rounded-pill mt-2">إضافة أول رول</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th class="text-start pe-4">#</th>
                                <th class="text-start">اسم الرول (Role Name)</th>
                                <th>المعرف البرمجي (Normalized Name)</th>
                                <th>معرف السجل (Id)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                            }
                            @foreach (var role in Model)
                            {
                                <tr>
                                    <td class="text-start pe-4 fw-bold text-muted">@index</td>
                                    <td class="text-start fw-bold text-dark">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-light rounded-3 p-2 text-primary">
                                                <i class="fa-solid fa-user-tag"></i>
                                            </div>
                                            <span>@role.Name</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill font-monospace">
                                            @role.NormalizedName
                                        </span>
                                    </td>
                                    <td class="text-muted small font-monospace">
                                        @role.Id
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
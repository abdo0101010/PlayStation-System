@model PlaystationSystem.Models.ApplicationUser

@{
    ViewData["Title"] = "تعديل بيانات الموظف";
}

<div class="container py-3" dir="rtl">

    <!-- Top Bar / Back Button -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-user-pen text-primary me-2"></i>تعديل بيانات الموظف
            </h3>
            <p class="text-muted small mb-0">تحديث معلومات الحساب للموظف: <strong>@Model.FullName</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-right me-1"></i> رجوع للوحة التحكم
        </a>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <form asp-action="EditUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Hidden ID -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">الاسم بالكامل</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-id-card text-muted"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="الاسم بالكامل" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Username -->
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label fw-bold">اسم المستخدم (Username)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                                <input asp-for="UserName" class="form-control" placeholder="اسم المستخدم" required />
                            </div>
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="example@domain.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">رقم الهاتف</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="010xxxxxxxx" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- IsActive Switch -->
                        <div class="mb-4 form-check form-switch dir-ltr d-flex align-items-center justify-content-between p-3 bg-light rounded-2 border">
                            <label class="form-check-label fw-bold mb-0 me-3" for="isActiveSwitch">حالة الحساب (نشط)</label>
                            <input class="form-check-input ms-0" type="checkbox" asp-for="IsActive" id="isActiveSwitch" style="width: 2.5em; height: 1.3em;">
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ التعديلات
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
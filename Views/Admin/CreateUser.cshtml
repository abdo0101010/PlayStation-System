@model User

@{
    ViewData["Title"] = "إضافة موظف جديد";
}

<div class="container py-3" dir="rtl">

    <!-- Top Bar / Back Button -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-user-plus text-success me-2"></i>إضافة موظف جديد
            </h3>
            <p class="text-muted small mb-0">أدخل بيانات الكاشير أو المسؤول لمنحه صلاحية الوصول للسيستم</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-right me-1"></i> رجوع للوحة التحكم
        </a>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <form asp-action="CreateUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Username -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">اسم المستخدم (Username)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                                <input asp-for="Username" class="form-control" placeholder="مثال: abdo_cashier" required />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">كلمة المرور</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                                <input asp-for="Password" type="password" class="form-control" placeholder="******" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">رقم الهاتف</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="010xxxxxxxx" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- Role Selection -->
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label fw-bold">الصلاحية (Role)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-user-shield text-muted"></i></span>
                                <select asp-for="Role" class="form-select">
                                    <option value="Cashier">كاشير (Cashier)</option>
                                    <option value="Admin">أدمن (Admin)</option>
                                </select>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <!-- IsActive Switch -->
                        <div class="mb-4 form-check form-switch dir-ltr d-flex align-items-center justify-content-between p-3 bg-light rounded-2 border">
                            <label class="form-check-label fw-bold mb-0 me-3" for="isActiveSwitch">تفعيل الحساب فوراً</label>
                            <input class="form-check-input ms-0" type="checkbox" asp-for="IsActive" id="isActiveSwitch" checked style="width: 2.5em; height: 1.3em;">
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-check-circle me-1"></i> حفظ البيانات
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
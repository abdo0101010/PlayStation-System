@using PlaystationSystem.ViewModel
@model IEnumerable<DrinksInventoryViewModel>

@{
    ViewData["Title"] = "إدارة المنتجات والمخزن";
}

<div class="container-fluid py-3" dir="rtl">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-boxes-stacked text-warning me-2"></i>إدارة المنتجات والمخزن
            </h2>
            <p class="text-muted small mb-0">متابعة أصناف الكافيه، المشروبات، المأكولات، والكميات المتاحة</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> إضافة منتج جديد
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 ms-2">
                <i class="fa-solid fa-arrow-right me-1"></i> العودة
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">إجمالي المنتجات</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalProducts صنف</h3>
                    </div>
                    <i class="fa-solid fa-box fa-2x text-white-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-danger text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">منتجات وشكت على النفاذ</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.LowStockCount أصناف</h3>
                    </div>
                    <i class="fa-solid fa-triangle-exclamation fa-2x text-white-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">إجمالي قيمة البضاعة بالمخزن</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalInventoryValue.ToString("N2") ج.م</h3>
                    </div>
                    <i class="fa-solid fa-wallet fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th># ID</th>
                            <th>اسم المنتج</th>
                            <th>سعر الشراء (التكلفة)</th>
                            <th>سعر البيع</th>
                            <th>الكمية المتاحة</th>
                            <th>حالة المخزون</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-muted py-4">لا توجد منتجات مسجلة حالياً</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@item.Id</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td><span class="text-secondary">@item.PurchasePrice.ToString("N2") ج.م</span></td>
                                    <td><span class="fw-bold text-success">@item.SellingPrice.ToString("N2") ج.م</span></td>
                                    <td><span class="fw-bold">@item.StockQuantity</span></td>
                                    <td>
                                        @if (item.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-1 rounded-pill">منتهي</span>
                                        }
                                        else if (item.IsLowStock)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-1 rounded-pill">كمية حرجة</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">متوفر</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">تعديل</a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('هل أنت متأكد من الحذف؟');">حذف</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
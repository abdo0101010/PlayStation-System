@model IEnumerable<PlaystationSystem.Models.Customer>

@{
    ViewData["Title"] = "قائمة العملاء والديون";
    Layout = "_Layout";
}

<div class="container-fluid py-4" dir="rtl">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-users text-primary me-2"></i> سجل العملاء والديون
            </h3>
            <p class="text-muted small mb-0">إدارة حسابات العملاء، المديونيات، وسجل الزيارات</p>
        </div>
        <div class="d-flex gap-2">
            <!-- زر سجل تحصيل الديون -->
            <a asp-action="GetDebtList" class="btn btn-outline-success rounded-pill px-4 shadow-sm fw-bold">
                <i class="fa-solid fa-receipt me-1"></i> سجل تحصيل الديون
            </a>
            <!-- زر إضافة عميل جديد -->
            <a asp-action="CreateCustomer" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="fa-solid fa-user-plus me-1"></i> إضافة عميل جديد
            </a>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" id="customerSearchInput" class="form-control border-start-0 ps-0" placeholder="ابحث باسم العميل أو رقم التليفون..." onkeyup="filterCustomers()" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center" id="customersTable">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th class="py-3">#</th>
                            <th class="py-3 text-start ps-4">اسم العميل</th>
                            <th class="py-3">رقم الهاتف</th>
                            <th class="py-3">إجمالي المديونية</th>
                            <th class="py-3">النقاط / الخصم</th>
                            <th class="py-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var customer in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@index</td>
                                    <td class="text-start ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@customer.Name</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-secondary fw-semibold">
                                        <i class="fa-solid fa-phone text-muted me-1 small"></i> @(customer.Phone ?? "غير مسجل")
                                    </td>
                                    <td>
                                        @if (customer.Debt > 0)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-2 fw-bold">
                                                @customer.Debt.ToString("N2") ج.م (عليه دين)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2 fw-bold">
                                                خالص (0.00 ج.م)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3 py-2 fw-bold">
                                            <i class="fa-solid fa-star me-1"></i> @customer.TotalPoints نقطة
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- تفاصيل / كشف حساب -->
                                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-info rounded-circle" title="كشف الحساب">
                                                <i class="fa-solid fa-file-invoice"></i>
                                            </a>
                                            <!-- سداد دين -->
                                            <a asp-action="PayDebt" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-success rounded-circle" title="سداد نقدية">
                                                <i class="fa-solid fa-hand-holding-dollar"></i>
                                            </a>
                                            <!-- تعديل -->
                                            <a asp-action="EditCustomer" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary rounded-circle" title="تعديل">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <!-- حذف -->
                                            <a asp-action="DeleteCustomer" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-danger rounded-circle" title="حذف">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-user-slash fa-3x mb-3 d-block text-secondary"></i>
                                    لا يوجد عملاء مسجلين حتى الآن.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterCustomers() {
            var input = document.getElementById("customerSearchInput");
            var filter = input.value.toLowerCase();
            var table = document.getElementById("customersTable");
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var nameTd = tr[i].getElementsByTagName("td")[1];
                var phoneTd = tr[i].getElementsByTagName("td")[2];
                if (nameTd || phoneTd) {
                    var nameText = nameTd.textContent || nameTd.innerText;
                    var phoneText = phoneTd.textContent || phoneTd.innerText;
                    if (nameText.toLowerCase().indexOf(filter) > -1 || phoneText.toLowerCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
}
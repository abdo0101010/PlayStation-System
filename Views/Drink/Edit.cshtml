@model PlaystationSystem.ViewModel.DrinksInventoryViewModel

@{
    ViewData["Title"] = "تعديل بيانات المنتج";
}

<div class="container py-3" dir="rtl">

    <!-- Top Bar & Back Button -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-pen-to-square text-primary me-2"></i>تعديل بيانات المنتج
            </h3>
            <p class="text-muted small mb-0">تحديث بيانات وشعار وسعر المنتج: <strong>@Model.Name</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-right me-1"></i> رجوع للمنتجات
        </a>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Primary Key (Hidden) -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-box text-muted"></i></span>
                                <input asp-for="Name" class="form-control" placeholder="اسم المنتج" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Purchase Price (Cost) -->
                        <div class="mb-3">
                            <label asp-for="PurchasePrice" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-money-bill-wave text-muted"></i></span>
                                <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" required />
                                <span class="input-group-text bg-light">ج.م</span>
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                        </div>

                        <!-- Selling Price -->
                        <div class="mb-3">
                            <label asp-for="SellingPrice" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-tag text-muted"></i></span>
                                <input asp-for="SellingPrice" type="number" step="0.01" class="form-control" required />
                                <span class="input-group-text bg-light">ج.م</span>
                            </div>
                            <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                        </div>

                        <!-- Stock Quantity -->
                        <div class="mb-4">
                            <label asp-for="StockQuantity" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-cubes text-muted"></i></span>
                                <input asp-for="StockQuantity" type="number" class="form-control" required min="0" />
                            </div>
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ التعديلات
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
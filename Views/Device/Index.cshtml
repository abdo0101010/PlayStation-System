@model IEnumerable<Device>

@{
    ViewData["Title"] = "إدارة الشاشات والأجهزة";
}

<div class="container-fluid py-3" dir="rtl">

    <!-- Top Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-gamepad text-primary me-2"></i>إدارة الأجهزة والشاشات
            </h2>
            <p class="text-muted small mb-0">متابعة حالة أجهزة البلايستيشن، أسعار الساعات، وإضافة أجهزة جديدة</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> إضافة جهاز جديد
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 ms-2">
                <i class="fa-solid fa-arrow-right me-1"></i> العودة
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">إجمالي الأجهزة</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.DevicesCount</h3>
                    </div>
                    <i class="fa-solid fa-tv fa-2x text-white-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">الأجهزة المتاحة حالياً</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.DevicesActive </h3>
                    </div>
                    <i class="fa-solid fa-circle-check fa-2x text-white-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-danger text-white rounded-3">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <h6 class="text-white-50 small mb-1">الأجهزة المشغولة</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.DevicesInactive </h3>
                    </div>
                    <i class="fa-solid fa-gamepad fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Devices Cards Grid -->
    <div class="row g-3">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-light border shadow-sm rounded-3 d-inline-block px-5 py-4">
                    <i class="fa-solid fa-tv fa-3x text-muted mb-3"></i>
                    <h5 class="text-secondary">لا توجد أجهزة أو شاشات مسجلة حالياً</h5>
                    <a asp-action="Create" class="btn btn-primary rounded-pill mt-2">إضافة جهاز الآن</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var device in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100 rounded-3 overflow-hidden">

                        <!-- Header Status -->
                        <div class="card-header border-0 py-3 d-flex justify-content-between align-items-center @(device.IsOccupied ? "bg-danger text-white" : "bg-success text-white")">
                            <h5 class="fw-bold mb-0">
                                <i class="fa-solid fa-tv me-2"></i>@device.Name
                            </h5>
                            @if (device.IsOccupied)
                            {
                                <span class="badge bg-white text-danger fw-bold rounded-pill">مشغول</span>
                            }
                            else
                            {
                                <span class="badge bg-white text-success fw-bold rounded-pill">متاح</span>
                            }
                        </div>

                        <!-- Device Body Details -->
                        <div class="card-body p-3">
                            <ul class="list-group list-group-flush small mb-3">
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                                    <span class="text-muted"><i class="fa-solid fa-layer-group me-1"></i>النوع:</span>
                                    <span class="fw-bold text-dark">@device.Type</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                                    <span class="text-muted"><i class="fa-solid fa-user me-1"></i>سعر السهم (Single):</span>
                                    <span class="fw-bold text-primary">@device.HourPriceSingle.ToString("N2") ج.م</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                                    <span class="text-muted"><i class="fa-solid fa-user-group me-1"></i>سعر السهم (Multi):</span>
                                    <span class="fw-bold text-primary">@device.HourPriceMulti.ToString("N2") ج.م</span>
                                </li>
                            </ul>

                            <!-- Actions -->
                            <div class="d-flex gap-2 border-top pt-3">
                                <a asp-action="Edit" asp-route-id="@device.Id" class="btn btn-sm btn-outline-primary flex-grow-1 rounded-pill">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>تعديل
                                </a>
                                <form asp-action="Delete" asp-route-id="@device.Id" method="post" style="display:inline;" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill" onclick="return confirm('هل أنت تأكد من حذف هذا الجهاز؟');">
                                        <i class="fa-solid fa-trash me-1"></i>حذف
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>
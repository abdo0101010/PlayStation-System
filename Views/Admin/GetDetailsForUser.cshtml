@using PlaystationSystem.Models
@model ApplicationUser

@{
    ViewData["Title"] = "تفاصيل الموظف";
}

<div class="container py-4" dir="rtl">

    <!-- Header & Back Button -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-address-card text-info me-2"></i>تفاصيل حساب الموظف
            </h3>
            <p class="text-muted small mb-0">عرض كافة البيانات الخاصة بالحساب والصلاحيات المسجلة</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-right me-1"></i> رجوع للوحة التحكم
        </a>
    </div>

    <!-- User Profile Card -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- Card Header Banner -->
                <div class="bg-primary bg-gradient p-4 text-center text-white position-relative">
                    <div class="mb-2">
                        <i class="fa-solid fa-circle-user fa-5x text-white-50"></i>
                    </div>
                    <h4 class="fw-bold mb-0">@Model.FullName</h4>
                    <span class="badge bg-light text-primary mt-2 px-3 py-1 rounded-pill fw-normal">
                        @Model.UserName
                    </span>
                </div>

                <!-- Card Details Body -->
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">

                        <!-- User ID -->
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                            <span class="text-muted"><i class="fa-solid fa-hashtag me-2"></i>معرف الموظف (ID)</span>
                            <span class="fw-bold text-dark text-break fs-7 ms-2">@Model.Id</span>
                        </li>

                        <!-- Full Name -->
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                            <span class="text-muted"><i class="fa-solid fa-id-card me-2"></i>الاسم بالكامل</span>
                            <span class="fw-semibold text-dark">@Model.FullName</span>
                        </li>

                        <!-- Username -->
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                            <span class="text-muted"><i class="fa-solid fa-user me-2"></i>اسم المستخدم</span>
                            <span class="fw-semibold text-dark">@Model.UserName</span>
                        </li>

                        <!-- Email -->
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                            <span class="text-muted"><i class="fa-solid fa-envelope me-2"></i>البريد الإلكتروني</span>
                            <span class="fw-semibold text-dark">
                                @(string.IsNullOrEmpty(Model.Email) ? "غير مسجل" : Model.Email)
                            </span>
                        </li>

                        <!-- Phone Number -->
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                            <span class="text-muted"><i class="fa-solid fa-phone me-2"></i>رقم الهاتف</span>
                            <span class="fw-semibold text-dark">
                                @(string.IsNullOrEmpty(Model.PhoneNumber) ? "غير مسجل" : Model.PhoneNumber)
                            </span>
                        </li>

                        <!-- Created At -->
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                            <span class="text-muted"><i class="fa-solid fa-calendar-day me-2"></i>تاريخ الإنشاء</span>
                            <span class="fw-semibold text-dark">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </li>

                        <!-- Account Status -->
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                            <span class="text-muted"><i class="fa-solid fa-shield-halved me-2"></i>حالة الحساب</span>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">
                                    <i class="fa-solid fa-check me-1"></i> نشط
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-1 rounded-pill">
                                    <i class="fa-solid fa-xmark me-1"></i> معطل
                                </span>
                            }
                        </li>

                    </ul>

                    <!-- Action Buttons inside Card -->
                    <div class="d-flex gap-2 mt-4 pt-2 border-top">
                        <a asp-action="EditUser" asp-route-id="@Model.Id" class="btn btn-primary flex-grow-1 rounded-pill fw-bold">
                            <i class="fa-solid fa-pen-to-square me-1"></i> تعديل البيانات
                        </a>
                        <a asp-action="Index" class="btn btn-light border flex-grow-1 rounded-pill text-secondary">
                            إغلاق
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
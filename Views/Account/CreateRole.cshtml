@model PlaystationSystem.ViewModel.CreateRoleViewModel

@{
    ViewData["Title"] = "إضافة صلاحية جديدة";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- رأس البطاقة -->
                <div class="card-header bg-dark text-white text-center py-4">
                    <div class="bg-white bg-opacity-10 rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                        <i class="fa-solid fa-shield-plus fa-2x text-warning"></i>
                    </div>
                    <h5 class="fw-bold mb-1">إضافة دور جديد (Role)</h5>
                    <small class="text-white-50">تحديد اسم الصلاحية للمستخدمين والكاشير</small>
                </div>

                <!-- جسم الفورم -->
                <div class="card-body p-4">
                    <form asp-action="CreateRole" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small p-2 mb-3" style="display: @(ViewData.ModelState.IsValid ? "none" : "block");"></div>

                        <div class="mb-4">
                            <label asp-for="RoleName" class="form-label fw-bold small text-muted mb-2">اسم الصلاحية / الرول</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 rounded-start-3">
                                    <i class="fa-solid fa-id-badge text-muted"></i>
                                </span>
                                <input asp-for="RoleName" class="form-control form-control-lg border-start-0 rounded-end-3" placeholder="مثال: Cashier أو Supervisor" autofocus />
                            </div>
                            <span asp-validation-for="RoleName" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted mt-2">
                                <i class="fa-solid fa-circle-info me-1"></i> يفضل كتابة اسم الرول بالإنجليزية وبشكل دقيق مثل: <code>Admin</code> أو <code>Cashier</code>.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ وإضافة الصلاحية
                            </button>
                            <a asp-action="RolesList" class="btn btn-outline-secondary rounded-pill">
                                إلغاء والرجوع للقائمة
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
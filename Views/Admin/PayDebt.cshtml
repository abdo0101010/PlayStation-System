@model PlaystationSystem.Models.Customer

@{
    ViewData["Title"] = "سداد نقدية - " + Model.Name;
    Layout = "_Layout";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="card-header bg-success text-white p-3 text-center">
                    <i class="fa-solid fa-hand-holding-dollar fa-3x mb-2"></i>
                    <h5 class="fw-bold mb-0">سند قبض / سداد نقدية</h5>
                    <small class="text-white-50">تحصيل مبالغ آجلة من العميل</small>
                </div>

                <div class="card-body p-4">
                    <!-- تفاصيل العميل والمديونية الحالية -->
                    <div class="bg-light rounded-3 p-3 mb-4 border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">اسم العميل:</span>
                            <span class="fw-bold text-dark">@Model.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">رقم الهاتف:</span>
                            <span class="text-secondary">@(Model.Phone ?? "غير مسجل")</span>
                        </div>
                        <hr class="my-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-danger">المديونية الحالية:</span>
                            <span class="badge bg-danger fs-6 px-3 py-2">
                                @Model.Debt.ToString("N2") ج.م
                            </span>
                        </div>
                    </div>

                    <!-- فورم السداد -->
                    <form asp-action="PayDebt" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerId" value="@Model.Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">المبلغ المستلم كاش <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-success bg-opacity-10 text-success border-success">
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                </span>
                                <input type="number"
                                       name="amountPaid"
                                       id="amountPaid"
                                       class="form-control border-success text-center fw-bold fs-4 text-success"
                                       placeholder="0.00"
                                       step="0.5"
                                       min="0.5"
                                       max="@Model.Debt"
                                       value="@Model.Debt"
                                       required
                                       autofocus />
                                <span class="input-group-text bg-success bg-opacity-10 text-success border-success fw-bold">ج.م</span>
                            </div>
                            <small class="text-muted mt-1 d-block">المبلغ الافتراضي هو كامل المديونية، يمكنك تعديله إذا كان سداداً جزئياً.</small>
                        </div>

                        <!-- الأزرار -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-check-circle me-1"></i> تأكيد استلام النقدية
                            </button>
                            <a asp-action="GetAllCustomers" class="btn btn-outline-secondary rounded-pill">
                                إلغاء ورجوع
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
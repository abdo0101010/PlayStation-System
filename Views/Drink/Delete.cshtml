@model PlaystationSystem.ViewModel.DrinksInventoryViewModel

@{
    ViewData["Title"] = "تأكيد حذف المنتج";
}

<div class="container py-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 text-center p-4">
                <div class="mb-3 text-danger">
                    <i class="fa-solid fa-circle-exclamation fa-4x"></i>
                </div>

                <h4 class="fw-bold mb-2">هل أنت متأكد من حذف هذا المنتج؟</h4>
                <p class="text-muted mb-4">سيتم حذف المنتج نهائياً من قاعدة البيانات ولا يمكن استرجاعه.</p>

                <div class="bg-light p-3 rounded-3 text-start mb-4 dir-rtl">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">اسم المنتج:</span>
                        <span class="fw-bold">@Model.Name</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">سعر البيع:</span>
                        <span class="fw-bold text-success">@Model.SellingPrice.ToString("N2") ج.م</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">الكمية بالمخزن:</span>
                        <span class="fw-bold">@Model.StockQuantity قطعة</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                            <i class="fa-solid fa-trash me-1"></i> نعم، تأكيد الحذف
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            إلغاء
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
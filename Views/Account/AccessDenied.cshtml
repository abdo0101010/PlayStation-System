@{
    ViewData["Title"] = "غير مسموح بالوصول";
    Layout = "_Layout";
}

<div class="container py-5 text-center" dir="rtl">
    <div class="row justify-content-center align-items-center min-vh-75">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-4 text-center">
                <div class="card-body">
                    <!-- Icon -->
                    <div class="text-danger mb-3">
                        <i class="fa-solid fa-shield-cat fa-5x"></i>
                    </div>

                    <!-- Title & Message -->
                    <h2 class="fw-bold text-dark mb-2">عذراً، غير مسموح لك بالوصول!</h2>
                    <p class="text-muted mb-4">
                        حسابك الحالى لا يمتلك الصلاحيات الكافية لاستعراض هذه الصفحة. يرجى المراجعة مع مسئول النظام (Admin) لو كنت تعتقد أن هذا خطأ.
                    </p>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="fa-solid fa-house me-1"></i> العودة للرئيسية
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                            <i class="fa-solid fa-user-gear me-1"></i> تبديل الحساب
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
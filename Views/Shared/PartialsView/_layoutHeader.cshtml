<header dir="rtl">
    <nav class="navbar navbar-dark bg-dark bg-opacity-95 shadow-sm px-4 py-2 sticky-top border-bottom border-secondary border-opacity-25">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- عنوان الصفحة أو مسار سريع -->
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h6 class="mb-0 text-white-50 fw-normal">لوحة التشغيل اليومية</h6>
            </div>

            <!-- الإجراءات السريعة وحالة الوردية -->
            <div class="d-flex align-items-center gap-3">

                <!-- زر تسجيل مصروف سريع -->
                <a asp-controller="Shift" asp-action="AddExpense" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                    <i class="fa-solid fa-minus-circle me-1"></i> تسجيل مصروف
                </a>

                <!-- بطاقة حالة الوردية -->
                <div class="bg-dark border border-success border-opacity-50 rounded-pill px-3 py-1 d-flex align-items-center gap-2 shadow-sm text-nowrap">
                    <span class="spinner-grow spinner-grow-sm text-success" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                    <span class="text-white-50 small">الوردية:</span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-0.5 fw-semibold small">
                        نشطة
                    </span>
                </div>

                <!-- قائمة المستخدم والتقفيل -->
                <div class="dropdown">
                    <button class="btn btn-dark border-secondary border-opacity-50 dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1 text-white" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-circle-user text-warning fs-5"></i>
                        <span class="small fw-semibold">
                            @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "حسابي")
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start shadow-lg border-secondary border-opacity-25 bg-dark mt-2" aria-labelledby="userMenu">
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2 text-warning" asp-controller="Shifts" asp-action="CloseShift">
                                <i class="fa-solid fa-lock"></i> إنهاء الوردية (تقفيل)
                            </a>
                        </li>
                        <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 text-danger border-0 bg-transparent w-100">
                                    <i class="fa-solid fa-right-from-bracket"></i> تسجيل الخروج
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>

        </div>
    </nav>
</header>